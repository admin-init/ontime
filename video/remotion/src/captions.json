[
  {"start": 0, "end": 3.0, "text": "官网一条。群聊一句。日历一条。"},
  {"start": 3.0, "end": 6.5, "text": "每一条都看到了。\n合起来还是拼不完整。"},
  {"start": 6.5, "end": 10.0, "text": "信息不是没有，是散着。"},
  {"start": 10.0, "end": 13.6, "text": "到点不替你判断真假。"},
  {"start": 13.6, "end": 18.0, "text": "它把每一条要求，\n连回原文。"},
  {"start": 18.0, "end": 22.5, "text": "一张通知，\n先变成几件要做的事。"},
  {"start": 22.5, "end": 24.9, "text": "活动、截止、地点、待办。"},
  {"start": 24.9, "end": 29.4, "text": "确认之前，它只是候选。"},
  {"start": 29.4, "end": 33.9, "text": "点开字段，就能回到原文。"},
  {"start": 33.9, "end": 40.0, "text": "截止没有依据，就写待确认。"},
  {"start": 40.0, "end": 43.2, "text": "第二份信息进来。"},
  {"start": 43.2, "end": 47.0, "text": "不是覆盖，是并列。"},
  {"start": 47.0, "end": 49.6, "text": "旧值、新值、出处，并排。"},
  {"start": 49.6, "end": 53.2, "text": "合并不是自动的，由你决定。"},
  {"start": 53.2, "end": 56.5, "text": "选一个，另一种留在历史。"},
  {"start": 56.5, "end": 59.5, "text": "两个地点，两个出处。"},
  {"start": 59.5, "end": 62.0, "text": "冲突不替你决定。"},
  {"start": 62.0, "end": 66.666, "text": "先搜一遍。"},
  {"start": 66.666, "end": 69.8, "text": "找不到，就说找不到。"},
  {"start": 69.8, "end": 73.8, "text": "贴上官方的链接，\n再核对一次。"},
  {"start": 73.8, "end": 78.1, "text": "6 条依据，每条都带原文。"},
  {"start": 78.1, "end": 82.0, "text": "找到就引用原文；\n找不到，就说没找到。"},
  {"start": 82.0, "end": 86.2, "text": "勾掉一项，未完成清零。"},
  {"start": 86.2, "end": 90.6, "text": "材料只有群聊提到，\n也标出来源。"},
  {"start": 90.6, "end": 93.2, "text": "历史只追加，不覆盖。"},
  {"start": 93.2, "end": 95.0, "text": "需要时，导出日历。"},
  {"start": 95.0, "end": 98.45, "text": "官网、邮箱：入口已在，\n尚未接入。"},
  {"start": 98.45, "end": 101.5, "text": "指定网站查询，还在规划。"},
  {"start": 101.5, "end": 105.0, "text": "到点。\n把信息变成有据可查的行动。"}
]
