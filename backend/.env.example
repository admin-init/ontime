# 复制为 backend/.env 后按需修改；.env 不入库。
# 模型 Key 只从这里或 ~/.ontime/llm_key 读取，禁止提交到仓库。
# LLM_API_KEY=

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=150

SCHOOL_NAME=西南交通大学
COLLEGE_NAME=数学学院
# 判定「本校官方来源」用的域名后缀；西南交大官网是 swjtu.edu.cn
SCHOOL_DOMAIN=swjtu.edu.cn

DATABASE_URL=sqlite:///ontime.db
DEMO_MODE=true
# 阶段一：官网 cron 调度；设为 false 只保留手动同步
SCHEDULER_ENABLED=true
